# Root-level ignore rules for a multi-service repository.

# Secrets and local environment files
.env
.env.*
!.env.example

# Python caches and virtual environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node and frontend build artifacts
node_modules/
dist/
coverage/
*.tsbuildinfo

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Repository-local temporary assessment files
.tmp_assessment/

# Office docs
*.docx